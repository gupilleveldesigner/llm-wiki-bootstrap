{
	"schemaVersion": "0.1.0",
	"name": "LLM Wiki — 책",
	"behavior": "create",
	"noteContentFormat": "# {{schema:name}}\n\n## 캡처 메모\n\n- 왜 저장했는가:\n- 현재 작업과의 연결:\n- 해보고 싶은 것:\n\n## 책 소개\n\n{{description}}\n\n## 수집 내용\n\n{{content}}",
	"properties": [
		{
			"name": "title",
			"value": "{{schema:name}}",
			"type": "text"
		},
		{
			"name": "source_type",
			"value": "book",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{schema:author[*].name|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "publisher",
			"value": "{{schema:publisher.name}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{schema:datePublished|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "isbn",
			"value": "{{schema:isbn}}",
			"type": "text"
		},
		{
			"name": "language",
			"value": "{{schema:inLanguage}}",
			"type": "text"
		},
		{
			"name": "pages",
			"value": "{{schema:numberOfPages}}",
			"type": "number"
		},
		{
			"name": "created",
			"value": "{{date|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "topics",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "ingest_status",
			"value": "pending",
			"type": "text"
		}
	],
	"triggers": [
		"schema:@Book",
		"https://www.goodreads.com/book/"
	],
	"noteNameFormat": "{{schema:name|safe_name}}",
	"path": "raw/reference/books"
}
